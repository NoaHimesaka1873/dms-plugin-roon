{
    "id": "roon",
    "name": "Roon",
    "description": "Roon zone control, library search, desktop now-playing and an MPRIS bridge",
    "version": "0.1.0",
    "author": "Noa Himesaka",
    "license": "MIT",
    "icon": "album",
    "type": "composite",
    "capabilities": ["daemon", "dankbar-widget", "control-center", "desktop-widget", "launcher"],
    "components": {
        "daemon": "./RoonDaemon.qml",
        "widget": "./RoonBarWidget.qml",
        "desktop": "./RoonDesktop.qml",
        "launcher": "./RoonLauncher.qml"
    },
    "trigger": "roon",
    "viewMode": "list",
    "settings": "./RoonSettings.qml",
    "startupCheck": "./StartupCheck.qml",
    "dependencies": ["node"],
    "requires_dms": ">=1.5.0",
    "permissions": ["settings_read", "settings_write", "process", "network"]
}
